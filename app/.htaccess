Options -Indexes

DirectoryIndex index.php

ErrorDocument 403 /error.php?code=403
ErrorDocument 404 /error.php?code=404
ErrorDocument 500 /error.php?code=500

<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- Rutas amigables del servicio ---
    RewriteRule ^panel/?$ dashboard.php [END,QSA]
    RewriteRule ^tickets/?$ tickets/lista.php [END,QSA]
    RewriteRule ^login/?$ login.php [END,QSA]
    RewriteRule ^logout/?$ logout.php [END,QSA]

    # --- Redirecciones 301 de rutas anteriores ---
    RewriteRule ^login\.php$ /login [R=301,L,QSA]
    RewriteRule ^logout\.php$ /logout [R=301,L,QSA]
    RewriteRule ^sqli\.php$ /directorio/usuarios [R=301,L,QSA]
    RewriteRule ^sqli-automated\.php$ /directorio/consulta [R=301,L,QSA]
    RewriteRule ^blind-sqli\.php$ /directorio/verificar [R=301,L,QSA]
    RewriteRule ^command\.php$ /red/diagnostico [R=301,L,QSA]
    RewriteRule ^file-include\.php$ /soporte/documentacion [R=301,L,QSA]
    RewriteRule ^upload\.php$ /tickets/adjuntos [R=301,L,QSA]
    RewriteRule ^xss-reflected\.php$ /soporte/buscar [R=301,L,QSA]
    RewriteRule ^xss-stored\.php$ /soporte/comentarios [R=301,L,QSA]
    RewriteRule ^xss-dom\.php$ /soporte/anuncios [R=301,L,QSA]
    RewriteRule ^login-security\.php$ /seguridad/accesos [R=301,L,QSA]
    RewriteRule ^security-info\.php$ /sistema/sesion [R=301,L,QSA]
    RewriteRule ^project\.php$ /sistema/acerca [R=301,L,QSA]
    RewriteRule ^evidence\.php$ /informes/hallazgo [R=301,L,QSA]
    RewriteRule ^xss-collector\.php$ /api/capturar-cookie [R=301,L,QSA]
    RewriteRule ^xss-dom-collector\.php$ /api/capturar-cookie-dom [R=301,L,QSA]
    RewriteRule ^user-search\.php$ /directorio/usuarios [R=301,L,QSA]

    # --- Resolución de extensiones para rutas amigables ---
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [END,QSA]
</IfModule>
